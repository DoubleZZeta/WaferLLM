param memcpy_params;

// Reduce/broadcast colors (global, identical on every PE). The per-PE routing
// itself is computed at runtime inside comm_pe.csl from this PE's coordinate,
// so the layout no longer passes per-PE comptime route structs.
param reduce_1st_color_0: color;
param reduce_1st_color_1: color;
param reduce_2nd_color_0: color;
param reduce_2nd_color_1: color;
param broadcast_color: color;

// -------------------------------------------------------------------------- //
// ---------------------------- Model Parameters ---------------------------- //
// -------------------------------------------------------------------------- //

param P: i16;
param bsz: i16;
param dim_p_pe: i16;
param rank_o_p_pe: i16;
param rank_qkv_p_pe: i16;
param rank_ffn_p_pe: i16;
param rank_down_p_pe: i16;
param enable_projection_profile: i16;
param pes_p_head: i16;
param pes_p_kv_head: i16;
param head_dim_p_pe: i16;
param seq_len_p_pe: i16;
param ffn_dim_p_pe: i16;

const _dim_p_pe: i16 = (dim_p_pe / 2) * 2;

param pe_num_p_group: i16;
param root_1st_phase: i16;
param root_2nd_phase: i16;

// -------------------------------------------------------------------------- //
// ------------------------------ PE Variables ------------------------------ //
// -------------------------------------------------------------------------- //

var px: i16 = 0;
var py: i16 = 0;

var quotient_x: i16 = 0;
var remainder_x: i16 = 0;
var quotient_y: i16 = 0;
var remainder_y: i16 = 0;

var head_dim: f16 = @as(f16,P * head_dim_p_pe);

const eps: f16 = 0.000001;
var alpha: f16 = 0.0;

// -------------------------------------------------------------------------- //
// --------------------------- WSE3 Modules Parameters ---------------------- //
// -------------------------------------------------------------------------- //

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const math = @import_module("<math>");
const layout_mod = @import_module("<layout>");

const comm_mod = @import_module("comm_lib/comm_pe.csl", .{
    .reduce_1st_color_0 = reduce_1st_color_0,
    .reduce_1st_color_1 = reduce_1st_color_1,
    .reduce_2nd_color_0 = reduce_2nd_color_0,
    .reduce_2nd_color_1 = reduce_2nd_color_1,
    .broadcast_color = broadcast_color,

    .P = P, .bsz = bsz, .dim_p_pe = dim_p_pe,
    .rank_o_p_pe = rank_o_p_pe,
    .rank_qkv_p_pe = rank_qkv_p_pe,
    .rank_ffn_p_pe = rank_ffn_p_pe,
    .rank_down_p_pe = rank_down_p_pe,
    .seq_len_p_pe = seq_len_p_pe,
    .ffn_dim_p_pe = ffn_dim_p_pe,

    .pe_num_p_group = pe_num_p_group,
    .root_1st_phase = root_1st_phase, .root_2nd_phase = root_2nd_phase,
});
// -------------------------------------------------------------------------- //
// ------------------------------ Timer Module ------------------------------ //
// -------------------------------------------------------------------------- //

const timestamp = @import_module("<time>");

var tsc_end_buf = @zeros([timestamp.tsc_size_words]u16);
var tsc_start_buf = @zeros([timestamp.tsc_size_words]u16);

var timer_buf = @zeros([3]f32);
var ptr_timer_buf: [*]f32 = &timer_buf;

// Optional projection profile. Each projection group is represented by the
// same three packed words as timer_buf (start timestamp + end timestamp).
// This buffer is populated only by projection_profile_host(), whose extra
// timestamp instructions are kept entirely out of decode_host().
const projection_profile_words: i16 = 12;
var projection_profile_buf = @zeros([projection_profile_words]f32);
var ptr_projection_profile_buf: [*]f32 = &projection_profile_buf;

var tsc_qkv_start = @zeros([timestamp.tsc_size_words]u16);
var tsc_qkv_end = @zeros([timestamp.tsc_size_words]u16);
var tsc_o_start = @zeros([timestamp.tsc_size_words]u16);
var tsc_o_end = @zeros([timestamp.tsc_size_words]u16);
var tsc_up_gate_start = @zeros([timestamp.tsc_size_words]u16);
var tsc_up_gate_end = @zeros([timestamp.tsc_size_words]u16);
var tsc_down_start = @zeros([timestamp.tsc_size_words]u16);
var tsc_down_end = @zeros([timestamp.tsc_size_words]u16);

var tsc_ref_buf = @zeros([timestamp.tsc_size_words]u16);
var time_ref_f32 = @zeros([2]f32);
var ptr_time_ref: [*]f32 = &time_ref_f32;

// -------------------------------------------------------------------------- //
// --------------------------------- Utils ---------------------------------- //
// -------------------------------------------------------------------------- //

fn init_task() void {
    timestamp.enable_tsc();

    px = @as(i16, layout_mod.get_x_coord());
    py = @as(i16, layout_mod.get_y_coord());

    quotient_x = @as(i16, math.floor_f16(@as(f16, px) / @as(f16, pe_num_p_group)));
    remainder_x = px - quotient_x * pe_num_p_group;

    quotient_y = @as(i16, math.floor_f16(@as(f16, py) / @as(f16, pe_num_p_group)));
    remainder_y = py - quotient_y * pe_num_p_group;

    comm_mod.init(px, py, quotient_x, remainder_x, quotient_y, remainder_y);

    alpha = 1.0 / @as(f16, math.sqrt(head_dim));

    sys_mod.unblock_cmd_stream();
}

const dest_dsr_1 = @get_dsr(dsr_dest, 1);
const src0_dsr_1 = @get_dsr(dsr_src0, 1);
const src1_dsr_1 = @get_dsr(dsr_src1, 1);

const dest_dsr_2 = @get_dsr(dsr_dest, 2);
const src0_dsr_2 = @get_dsr(dsr_src0, 2);
const src1_dsr_2 = @get_dsr(dsr_src1, 2);

const dest_dsr_3 = @get_dsr(dsr_dest, 3);
const src0_dsr_3 = @get_dsr(dsr_src0, 3);
const src1_dsr_3 = @get_dsr(dsr_src1, 3);

const dest_dsr_4 = @get_dsr(dsr_dest, 4);
const src0_dsr_4 = @get_dsr(dsr_src0, 4);
const src1_dsr_4 = @get_dsr(dsr_src1, 4);

const dest_dsr_5 = @get_dsr(dsr_dest, 5);
const src0_dsr_5 = @get_dsr(dsr_src0, 5);
const src1_dsr_5 = @get_dsr(dsr_src1, 5);

fn gemv_static_step(cur: f16) void {
    @fmach(dest_dsr_1, src0_dsr_1, src1_dsr_1, cur);
}

fn fsubh_func(cur: f16) void {
    @fsubh(dest_dsr_1, src0_dsr_1, cur);
}

var cur_: f16 = 0.0;
fn fmulh_norm_func(cur: f16) void {
    cur_ = cur / head_dim;
    cur_ = 1.0 / math.sqrt(cur_ + eps);
    @fmulh(dest_dsr_1, src0_dsr_1, cur_);
}

fn fast_exp(x: f16) f16 {
    var tmp: f16 = x;
    tmp = 1.0 + tmp/256.0;
    tmp *= tmp;
    tmp *= tmp;

    return tmp;
}

fn fmulh_softmax_func(cur: f16) void {
    cur_ = 1.0 / cur;
    @fmulh(dest_dsr_1, src0_dsr_1, cur_);
}

var dummy = @zeros([1]f16);

var ptr_left_vector: [*]f16 = &dummy;
var left_vector_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &dummy, .extent = 1 });

var ptr_right_matrix: [*]f16 = &dummy;
var right_matrix_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &dummy, .extent = 1 });

var ptr_out_vector: [*]f16 = &dummy;
var out_vector_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &dummy, .extent = 1 });

var dim_p_pe_dsd_1 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{dim_p_pe} -> dummy[i] });
var dim_p_pe_dsd_2 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{dim_p_pe} -> dummy[i] });
var seq_len_p_pe_dsd_1 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{seq_len_p_pe} -> dummy[i] });
var seq_len_p_pe_dsd_2 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{seq_len_p_pe} -> dummy[i] });
var ffn_dim_p_pe_dsd_1 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{ffn_dim_p_pe} -> dummy[i] });
var ffn_dim_p_pe_dsd_2 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{ffn_dim_p_pe} -> dummy[i] });

var Kt: i16 = 0;
var Nt: i16 = 0;

fn vecmat_computation() void {
    left_vector_dsd = @set_dsd_length(left_vector_dsd, @bitcast(u16, Kt));
    right_matrix_dsd = @set_dsd_length(right_matrix_dsd, @bitcast(u16, Nt));
    out_vector_dsd = @set_dsd_length(out_vector_dsd, @bitcast(u16, Nt));
    
    for (@range(i16, bsz)) |b| {
        right_matrix_dsd = @set_dsd_base_addr(right_matrix_dsd, ptr_right_matrix);

        @load_to_dsr(dest_dsr_1, out_vector_dsd, .{ .save_address = false });
        @load_to_dsr(src0_dsr_1, out_vector_dsd, .{ .save_address = false });
        @load_to_dsr(src1_dsr_1, right_matrix_dsd, .{ .save_address = true });

        @map(gemv_static_step, left_vector_dsd); // MFU 2x4Kx4K-flops

        left_vector_dsd = @increment_dsd_offset(left_vector_dsd, Kt, f16);
        out_vector_dsd = @increment_dsd_offset(out_vector_dsd, Nt, f16);
    }

}

// -------------------------------------------------------------------------- //
// ----------------------------- Model Parameters --------------------------- //
// -------------------------------------------------------------------------- //

// * X: input
var X_tile: [bsz * dim_p_pe]f16 = @zeros([bsz * dim_p_pe]f16);
var ptr_X: [*]f16 = &X_tile;
var X_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &X_tile, .extent = bsz * dim_p_pe });

// * W: RMSNorm weights
var W_tile: [dim_p_pe]f16 = @zeros([dim_p_pe]f16);
var ptr_W: [*]f16 = &W_tile;
var W_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &W_tile, .extent = dim_p_pe });

// Q/K/V are each represented by A [dim, rank_qkv] and
// B [rank_qkv, dim]. Equal ranks allow their collectives to remain fused.
var Q_A_weight_tile: [dim_p_pe * rank_qkv_p_pe]f16 = @zeros([dim_p_pe * rank_qkv_p_pe]f16);
var ptr_Q_A_weight: [*]f16 = &Q_A_weight_tile;
var Q_B_weight_tile: [rank_qkv_p_pe * dim_p_pe]f16 = @zeros([rank_qkv_p_pe * dim_p_pe]f16);
var ptr_Q_B_weight: [*]f16 = &Q_B_weight_tile;
var K_A_weight_tile: [dim_p_pe * rank_qkv_p_pe]f16 = @zeros([dim_p_pe * rank_qkv_p_pe]f16);
var ptr_K_A_weight: [*]f16 = &K_A_weight_tile;
var K_B_weight_tile: [rank_qkv_p_pe * dim_p_pe]f16 = @zeros([rank_qkv_p_pe * dim_p_pe]f16);
var ptr_K_B_weight: [*]f16 = &K_B_weight_tile;
var V_A_weight_tile: [dim_p_pe * rank_qkv_p_pe]f16 = @zeros([dim_p_pe * rank_qkv_p_pe]f16);
var ptr_V_A_weight: [*]f16 = &V_A_weight_tile;
var V_B_weight_tile: [rank_qkv_p_pe * dim_p_pe]f16 = @zeros([rank_qkv_p_pe * dim_p_pe]f16);
var ptr_V_B_weight: [*]f16 = &V_B_weight_tile;

var freqs_sin: [_dim_p_pe / 2]f16 = @zeros([_dim_p_pe / 2]f16);
var ptr_freqs_sin: [*]f16 = &freqs_sin;
var freqs_sin_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &freqs_sin, .extent = _dim_p_pe / 2 });

var freqs_cos: [_dim_p_pe / 2]f16 = @zeros([_dim_p_pe / 2]f16);
var ptr_freqs_cos: [*]f16 = &freqs_cos;
var freqs_cos_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &freqs_cos, .extent = _dim_p_pe / 2 });

var XKCache_tile: [dim_p_pe * seq_len_p_pe]f16 = @zeros([dim_p_pe * seq_len_p_pe]f16);
var ptr_XKCache: [*]f16 = &XKCache_tile;

var XVCache_tile: [seq_len_p_pe * dim_p_pe]f16 = @zeros([seq_len_p_pe * dim_p_pe]f16);
var ptr_XVCache: [*]f16 = &XVCache_tile;

// o_proj is factorized as O ~= O_A @ O_B, where
// O_A has shape [dim, rank_o] and O_B has shape [rank_o, dim].  Every PE owns
// one 2-D block from each factor.  The rank-sized intermediate stays on wafer.
var O_A_weight_tile: [dim_p_pe * rank_o_p_pe]f16 = @zeros([dim_p_pe * rank_o_p_pe]f16);
var ptr_O_A_weight: [*]f16 = &O_A_weight_tile;

var O_B_weight_tile: [rank_o_p_pe * dim_p_pe]f16 = @zeros([rank_o_p_pe * dim_p_pe]f16);
var ptr_O_B_weight: [*]f16 = &O_B_weight_tile;

var UP_A_weight_tile: [dim_p_pe * rank_ffn_p_pe]f16 = @zeros([dim_p_pe * rank_ffn_p_pe]f16);
var ptr_UP_A_weight: [*]f16 = &UP_A_weight_tile;
var UP_B_weight_tile: [rank_ffn_p_pe * ffn_dim_p_pe]f16 = @zeros([rank_ffn_p_pe * ffn_dim_p_pe]f16);
var ptr_UP_B_weight: [*]f16 = &UP_B_weight_tile;
var GATE_A_weight_tile: [dim_p_pe * rank_ffn_p_pe]f16 = @zeros([dim_p_pe * rank_ffn_p_pe]f16);
var ptr_GATE_A_weight: [*]f16 = &GATE_A_weight_tile;
var GATE_B_weight_tile: [rank_ffn_p_pe * ffn_dim_p_pe]f16 = @zeros([rank_ffn_p_pe * ffn_dim_p_pe]f16);
var ptr_GATE_B_weight: [*]f16 = &GATE_B_weight_tile;

// down_proj is DOWN_A [ffn_dim, rank_down] followed by
// DOWN_B [rank_down, dim]. The intermediate never leaves the wafer.
var DOWN_A_weight_tile: [ffn_dim_p_pe * rank_down_p_pe]f16 = @zeros([ffn_dim_p_pe * rank_down_p_pe]f16);
var ptr_DOWN_A_weight: [*]f16 = &DOWN_A_weight_tile;

var DOWN_B_weight_tile: [rank_down_p_pe * dim_p_pe]f16 = @zeros([rank_down_p_pe * dim_p_pe]f16);
var ptr_DOWN_B_weight: [*]f16 = &DOWN_B_weight_tile;

// ************************ Middle Results ************************ //

var X_tmp: [bsz * dim_p_pe]f16 = @zeros([bsz * dim_p_pe]f16);
var ptr_X_tmp: [*]f16 = &X_tmp;
var X_tmp_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &X_tmp, .extent = bsz * dim_p_pe });

var X_norm_tile: [bsz * dim_p_pe]f16 = @zeros([bsz * dim_p_pe]f16);
var ptr_X_norm: [*]f16 = &X_norm_tile;

var X_even_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &dummy, .offset = 0, .extent = _dim_p_pe / 2, .stride = 2 });
var X_odd_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &dummy, .offset = 1, .extent = _dim_p_pe / 2, .stride = 2 });

var local_sum: [bsz]f16 = @zeros([bsz]f16);
var ptr_local_sum: [*]f16 = &local_sum;
var local_sum_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &local_sum, .extent = bsz });

var sum: f16 = 0.0;
var ptr_sum = &sum;

var local_max: [bsz]f16 = @zeros([bsz]f16);
var ptr_local_max: [*]f16 = &local_max;
var local_max_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &local_max, .extent = bsz });

var max: f16 = 0.0;
var ptr_max = &max;

var X_tmp_1: [_dim_p_pe / 2]f16 = @zeros([_dim_p_pe / 2]f16);
var ptr_X_tmp_1: [*]f16 = &X_tmp_1;
var X_tmp_1_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &X_tmp_1, .extent = _dim_p_pe / 2 });

var X_tmp_2: [_dim_p_pe / 2]f16 = @zeros([_dim_p_pe / 2]f16);
var ptr_X_tmp_2: [*]f16 = &X_tmp_2;
var X_tmp_2_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &X_tmp_2, .extent = _dim_p_pe / 2 });

var X_tmp_3: [_dim_p_pe / 2]f16 = @zeros([_dim_p_pe / 2]f16);
var ptr_X_tmp_3: [*]f16 = &X_tmp_3;
var X_tmp_3_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &X_tmp_3, .extent = _dim_p_pe / 2 });

var X_tmp_4: [_dim_p_pe / 2]f16 = @zeros([_dim_p_pe / 2]f16);
var ptr_X_tmp_4: [*]f16 = &X_tmp_4;
var X_tmp_4_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &X_tmp_4, .extent = _dim_p_pe / 2 });

// * XQKV: Q, K, V are fused into one contiguous QKV_tile so a single
// * all-reduce can cover all three projections (offsets 0 / bsz*dim_p_pe / 2*bsz*dim_p_pe).
var QKV_tile: [bsz*3*dim_p_pe]f16 = @zeros([bsz*3*dim_p_pe]f16);
var ptr_QKV_tile: [*]f16 = &QKV_tile;

// Fused rank-sized outputs of X_norm @ {Q_A,K_A,V_A}.
var QKV_rank_tile: [bsz*3*rank_qkv_p_pe]f16 = @zeros([bsz*3*rank_qkv_p_pe]f16);
var ptr_QKV_rank_tile: [*]f16 = &QKV_rank_tile;
var Q_rank_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &QKV_rank_tile, .offset = 0, .extent = bsz*rank_qkv_p_pe });
var K_rank_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &QKV_rank_tile, .offset = bsz*rank_qkv_p_pe, .extent = bsz*rank_qkv_p_pe });
var V_rank_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &QKV_rank_tile, .offset = 2*bsz*rank_qkv_p_pe, .extent = bsz*rank_qkv_p_pe });

var Q_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &QKV_tile, .offset = 0, .extent = bsz*dim_p_pe });
var K_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &QKV_tile, .offset = bsz*dim_p_pe, .extent = bsz*dim_p_pe });
var V_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &QKV_tile, .offset = 2*bsz*dim_p_pe, .extent = bsz*dim_p_pe });

var score: [bsz * seq_len_p_pe]f16 = @zeros([bsz * seq_len_p_pe]f16);
var ptr_score: [*]f16 = &score;
var score_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &score, .extent = bsz * seq_len_p_pe });

var score_tmp: [bsz * seq_len_p_pe]f16 = @zeros([bsz * seq_len_p_pe]f16);
var ptr_score_tmp: [*]f16 = &score_tmp;
var score_tmp_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &score_tmp, .extent = bsz * seq_len_p_pe });

var output_tile: [bsz * dim_p_pe]f16 = @zeros([bsz * dim_p_pe]f16);
var ptr_output: [*]f16 = &output_tile;
var output_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &output_tile, .extent = bsz * dim_p_pe });

var h1_tile: [bsz * dim_p_pe]f16 = @zeros([bsz * dim_p_pe]f16);
var ptr_h1: [*]f16 = &h1_tile;
var h1_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &h1_tile, .extent = bsz * dim_p_pe });

// Intermediate produced by output @ O_A.  It is deliberately not copied to
// the host between the two GEMVs; avoiding that boundary is the fused-kernel
// behaviour we want to measure inside Decode.
var o_rank_tile: [bsz * rank_o_p_pe]f16 = @zeros([bsz * rank_o_p_pe]f16);
var ptr_o_rank: [*]f16 = &o_rank_tile;
var o_rank_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &o_rank_tile, .extent = bsz * rank_o_p_pe });

var h2_tile: [bsz * dim_p_pe]f16 = @zeros([bsz * dim_p_pe]f16);
var ptr_h2: [*]f16 = &h2_tile;
var h2_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &h2_tile, .extent = bsz * dim_p_pe });

// UP (z1) and GATE (z2) projections are fused into one contiguous ZZ_tile so a
// single all-reduce covers both (offsets 0 / bsz*ffn_dim_p_pe).
var ZZ_tile: [bsz * 2 * ffn_dim_p_pe]f16 = @zeros([bsz * 2 * ffn_dim_p_pe]f16);
var ptr_ZZ_tile: [*]f16 = &ZZ_tile;

var ZZ_rank_tile: [bsz * 2 * rank_ffn_p_pe]f16 = @zeros([bsz * 2 * rank_ffn_p_pe]f16);
var ptr_ZZ_rank_tile: [*]f16 = &ZZ_rank_tile;
var up_rank_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &ZZ_rank_tile, .offset = 0, .extent = bsz * rank_ffn_p_pe });
var gate_rank_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &ZZ_rank_tile, .offset = bsz * rank_ffn_p_pe, .extent = bsz * rank_ffn_p_pe });

var z1_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &ZZ_tile, .offset = 0, .extent = bsz * ffn_dim_p_pe });
var z2_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &ZZ_tile, .offset = bsz * ffn_dim_p_pe, .extent = bsz * ffn_dim_p_pe });

var z3_tile: [bsz * ffn_dim_p_pe]f16 = @zeros([bsz * ffn_dim_p_pe]f16);
var ptr_z3: [*]f16 = &z3_tile;
var z3_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &z3_tile, .extent = bsz * ffn_dim_p_pe });

// Partial rank output of z3 @ DOWN_A. It is sharded by PE row after the
// X-axis reduction and is consumed directly by the second factor GEMV.
var down_rank_tile: [bsz * rank_down_p_pe]f16 = @zeros([bsz * rank_down_p_pe]f16);
var ptr_down_rank: [*]f16 = &down_rank_tile;
var down_rank_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &down_rank_tile, .extent = bsz * rank_down_p_pe });

var z_norm_tile: [bsz * dim_p_pe]f16 = @zeros([bsz * dim_p_pe]f16);
var ptr_z_norm: [*]f16 = &z_norm_tile;
var z_norm_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &z_norm_tile, .extent = bsz * dim_p_pe });

var Z_tile: [bsz * dim_p_pe]f16 = @zeros([bsz * dim_p_pe]f16);
var ptr_Z: [*]f16 = &Z_tile;
var Z_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &Z_tile, .extent = bsz * dim_p_pe });


// -------------------------------------------------------------------------- //
// ------------------------------ Decode Funcs ------------------------------ //
// -------------------------------------------------------------------------- //

fn rmsnorm_x() void {
    @load_to_dsr(dest_dsr_1, X_tmp_dsd);
    @load_to_dsr(src0_dsr_1, X_dsd);
    @load_to_dsr(src1_dsr_1, X_dsd);
    @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);

    dim_p_pe_dsd_1 = @set_dsd_base_addr(dim_p_pe_dsd_1, ptr_X_tmp);
    @load_to_dsr(src1_dsr_1, dim_p_pe_dsd_1, .{ .save_address = true });
    for (@range(i16, bsz)) |b| {
        sum = 0.0;
        @faddh(ptr_sum, sum, src1_dsr_1);
        local_sum[b] = sum;
    }

    comm_mod.all_reduce_bsz(py, quotient_y, remainder_y, ptr_local_sum);

    dim_p_pe_dsd_1 = @set_dsd_base_addr(dim_p_pe_dsd_1, ptr_X_norm);
    dim_p_pe_dsd_2 = @set_dsd_base_addr(dim_p_pe_dsd_2, ptr_X_tmp);
    @load_to_dsr(dest_dsr_1, dim_p_pe_dsd_1, .{ .save_address = true});
    @load_to_dsr(src0_dsr_1, dim_p_pe_dsd_2, .{ .save_address = true});
    @load_to_dsr(src1_dsr_1, W_dsd, .{ .save_address = false});
    for (@range(i16, bsz)) |b| {
        @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
    }

    dim_p_pe_dsd_1 = @set_dsd_base_addr(dim_p_pe_dsd_1, ptr_X_norm);
    @load_to_dsr(dest_dsr_1, dim_p_pe_dsd_1, .{ .save_address = true});
    @load_to_dsr(src0_dsr_1, dim_p_pe_dsd_1, .{ .save_address = true});
    @map(fmulh_norm_func, local_sum_dsd);
}

fn xq_matvec_mult() void {
    @fmovh(Q_rank_dsd, 0.0);
    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_X_norm);
    ptr_right_matrix = &Q_A_weight_tile;
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_QKV_rank_tile);
    Kt = dim_p_pe;
    Nt = rank_qkv_p_pe;
    vecmat_computation();
}

fn xk_matvec_mult() void {
    @fmovh(K_rank_dsd, 0.0);
    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_X_norm);
    ptr_right_matrix = &K_A_weight_tile;
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_QKV_rank_tile);
    out_vector_dsd = @increment_dsd_offset(out_vector_dsd, bsz*rank_qkv_p_pe, f16);
    Kt = dim_p_pe;
    Nt = rank_qkv_p_pe;
    vecmat_computation();
}

fn xv_matvec_mult() void {
    @fmovh(V_rank_dsd, 0.0);
    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_X_norm);
    ptr_right_matrix = &V_A_weight_tile;
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_QKV_rank_tile);
    out_vector_dsd = @increment_dsd_offset(out_vector_dsd, 2*bsz*rank_qkv_p_pe, f16);
    Kt = dim_p_pe;
    Nt = rank_qkv_p_pe;
    vecmat_computation();
}

fn qkv_low_rank_stage2() void {
    // The first factor outputs were reduced together on Y. Switch to X and
    // reconstruct all three hidden-sized projections, then fuse that reduce.
    comm_mod.reconfig_allreduce_axis(0);
    @fmovh(Q_dsd, 0.0);
    @fmovh(K_dsd, 0.0);
    @fmovh(V_dsd, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_QKV_rank_tile);
    ptr_right_matrix = &Q_B_weight_tile;
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_QKV_tile);
    Kt = rank_qkv_p_pe; Nt = dim_p_pe; vecmat_computation();

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_QKV_rank_tile);
    left_vector_dsd = @increment_dsd_offset(left_vector_dsd, bsz*rank_qkv_p_pe, f16);
    ptr_right_matrix = &K_B_weight_tile;
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_QKV_tile);
    out_vector_dsd = @increment_dsd_offset(out_vector_dsd, bsz*dim_p_pe, f16);
    Kt = rank_qkv_p_pe; Nt = dim_p_pe; vecmat_computation();

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_QKV_rank_tile);
    left_vector_dsd = @increment_dsd_offset(left_vector_dsd, 2*bsz*rank_qkv_p_pe, f16);
    ptr_right_matrix = &V_B_weight_tile;
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_QKV_tile);
    out_vector_dsd = @increment_dsd_offset(out_vector_dsd, 2*bsz*dim_p_pe, f16);
    Kt = rank_qkv_p_pe; Nt = dim_p_pe; vecmat_computation();

    comm_mod.all_reduce_bsz_dim_QKV_fusion(px, quotient_x, remainder_x, ptr_QKV_tile);
}

fn xq_rope() void {
    X_even_dsd = @set_dsd_base_addr(X_even_dsd, ptr_QKV_tile);
    X_odd_dsd = @set_dsd_base_addr(X_odd_dsd, ptr_QKV_tile);

    @load_to_dsr(dest_dsr_1, X_tmp_1_dsd);
    @load_to_dsr(dest_dsr_2, X_tmp_2_dsd);
    @load_to_dsr(dest_dsr_3, X_tmp_3_dsd);
    @load_to_dsr(dest_dsr_4, X_tmp_4_dsd);

    @load_to_dsr(src1_dsr_1, freqs_cos_dsd);
    @load_to_dsr(src1_dsr_2, freqs_sin_dsd);
    @load_to_dsr(src1_dsr_3, freqs_cos_dsd);
    @load_to_dsr(src1_dsr_4, freqs_sin_dsd);

    for (@range(i16, bsz)) |b| {

        @load_to_dsr(src0_dsr_1, X_odd_dsd);
        @load_to_dsr(src0_dsr_2, X_even_dsd);
        @load_to_dsr(src0_dsr_3, X_even_dsd);
        @load_to_dsr(src0_dsr_4, X_odd_dsd);

        @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
        @fmulh(dest_dsr_2, src0_dsr_2, src1_dsr_2);
        @fmulh(dest_dsr_3, src0_dsr_3, src1_dsr_3);
        @fmulh(dest_dsr_4, src0_dsr_4, src1_dsr_4);

        @load_to_dsr(dest_dsr_5, X_even_dsd);
        @load_to_dsr(src0_dsr_5, X_tmp_1_dsd);
        @load_to_dsr(src1_dsr_5, X_tmp_2_dsd);
        @fsubh(dest_dsr_5, src0_dsr_5, src1_dsr_5);

        @load_to_dsr(dest_dsr_5, X_odd_dsd);
        @load_to_dsr(src0_dsr_5, X_tmp_3_dsd);
        @load_to_dsr(src1_dsr_5, X_tmp_4_dsd);
        @faddh(dest_dsr_5, src0_dsr_5, src1_dsr_5);

        X_even_dsd = @increment_dsd_offset(X_even_dsd, dim_p_pe, f16);
        X_odd_dsd = @increment_dsd_offset(X_odd_dsd, dim_p_pe, f16);
    }
}

fn xk_rope() void {
    X_even_dsd = @set_dsd_base_addr(X_even_dsd, ptr_QKV_tile);
    X_odd_dsd = @set_dsd_base_addr(X_odd_dsd, ptr_QKV_tile);
    X_even_dsd = @increment_dsd_offset(X_even_dsd, bsz*dim_p_pe, f16);
    X_odd_dsd = @increment_dsd_offset(X_odd_dsd, bsz*dim_p_pe, f16);

    @load_to_dsr(dest_dsr_1, X_tmp_1_dsd);
    @load_to_dsr(dest_dsr_2, X_tmp_2_dsd);
    @load_to_dsr(dest_dsr_3, X_tmp_3_dsd);
    @load_to_dsr(dest_dsr_4, X_tmp_4_dsd);

    @load_to_dsr(src1_dsr_1, freqs_cos_dsd);
    @load_to_dsr(src1_dsr_2, freqs_sin_dsd);
    @load_to_dsr(src1_dsr_3, freqs_cos_dsd);
    @load_to_dsr(src1_dsr_4, freqs_sin_dsd);

    for (@range(i16, bsz)) |b| {

        @load_to_dsr(src0_dsr_1, X_odd_dsd);
        @load_to_dsr(src0_dsr_2, X_even_dsd);
        @load_to_dsr(src0_dsr_3, X_even_dsd);
        @load_to_dsr(src0_dsr_4, X_odd_dsd);

        @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
        @fmulh(dest_dsr_2, src0_dsr_2, src1_dsr_2);
        @fmulh(dest_dsr_3, src0_dsr_3, src1_dsr_3);
        @fmulh(dest_dsr_4, src0_dsr_4, src1_dsr_4);

        @load_to_dsr(dest_dsr_5, X_even_dsd);
        @load_to_dsr(src0_dsr_5, X_tmp_1_dsd);
        @load_to_dsr(src1_dsr_5, X_tmp_2_dsd);
        @fsubh(dest_dsr_5, src0_dsr_5, src1_dsr_5);

        @load_to_dsr(dest_dsr_5, X_odd_dsd);
        @load_to_dsr(src0_dsr_5, X_tmp_3_dsd);
        @load_to_dsr(src1_dsr_5, X_tmp_4_dsd);
        @faddh(dest_dsr_5, src0_dsr_5, src1_dsr_5);

        X_even_dsd = @increment_dsd_offset(X_even_dsd, dim_p_pe, f16);
        X_odd_dsd = @increment_dsd_offset(X_odd_dsd, dim_p_pe, f16);
    }
}

fn score_matvec_mult() void {
    @fmovh(score_dsd, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_QKV_tile);
    
    ptr_right_matrix = &XKCache_tile;

    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_score);

    Kt = dim_p_pe;
    Nt = seq_len_p_pe;

    vecmat_computation();

    comm_mod.all_reduce_bsz_seq_len(px, quotient_x, remainder_x, ptr_score);

    // score factor
    @load_to_dsr(dest_dsr_1, score_dsd);
    @load_to_dsr(src0_dsr_1, score_dsd);
    @fmulh(dest_dsr_1, src0_dsr_1, alpha);
}

fn softmax_score() void {

    seq_len_p_pe_dsd_1 = @set_dsd_base_addr(seq_len_p_pe_dsd_1, ptr_score);
    @load_to_dsr(src1_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
    for (@range(i16, bsz)) |b| {
        max = 0.0;
        @fmaxh(ptr_max, max, src1_dsr_1);
        local_max[b] = max;
    }

    comm_mod.all_reduceMax_bsz(py, quotient_y, remainder_y, ptr_local_max);

    seq_len_p_pe_dsd_1 = @set_dsd_base_addr(seq_len_p_pe_dsd_1, ptr_score_tmp);
    seq_len_p_pe_dsd_2 = @set_dsd_base_addr(seq_len_p_pe_dsd_2, ptr_score);
    @load_to_dsr(dest_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
    @load_to_dsr(src0_dsr_1, seq_len_p_pe_dsd_2, .{ .save_address = true });
    @map(fsubh_func, local_max_dsd);

    @map(fast_exp, score_tmp_dsd, score_dsd);

    seq_len_p_pe_dsd_1 = @set_dsd_base_addr(seq_len_p_pe_dsd_1, ptr_score);
    @load_to_dsr(src1_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
    for (@range(i16, bsz)) |b| {
        sum = 0.0;
        @faddh(ptr_sum, sum, src1_dsr_1);
        local_sum[b] = sum;
    }

    comm_mod.all_reduce_bsz(py, quotient_y, remainder_y, ptr_local_sum);

    seq_len_p_pe_dsd_1 = @set_dsd_base_addr(seq_len_p_pe_dsd_1, ptr_score);
    @load_to_dsr(dest_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
    @load_to_dsr(src0_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
    @map(fmulh_softmax_func, local_sum_dsd);
}

fn output_matvec_mult() void {
    @fmovh(output_dsd, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_score);
    
    ptr_right_matrix = &XVCache_tile;

    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_output);

    Kt = seq_len_p_pe;
    Nt = dim_p_pe;

    vecmat_computation();

    comm_mod.all_reduce_bsz_dim(py, quotient_y, remainder_y, ptr_output);
}

fn o_low_rank_matvec_mult() void {
    // Stage 1: local [dim/P] x [rank/P] GEMV, followed by an X-axis
    // all-reduce.  The attention output is already distributed in the
    // orientation consumed by the original dense o_proj, so this is the same
    // axis on which the dense implementation performed its reduction.
    @fmovh(o_rank_dsd, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_output);
    ptr_right_matrix = &O_A_weight_tile;
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_o_rank);
    Kt = dim_p_pe;
    Nt = rank_o_p_pe;
    vecmat_computation();

    comm_mod.all_reduce_bsz_rank_o(px, quotient_x, remainder_x, ptr_o_rank);

    // Stage 2 consumes the rank shard locally, then reduces the partial
    // hidden-dimension result on the orthogonal Y axis.  The resulting h1
    // distribution again matches X, so the residual add below is unchanged.
    comm_mod.reconfig_allreduce_axis(1);
    @fmovh(h1_dsd, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_o_rank);
    ptr_right_matrix = &O_B_weight_tile;
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_h1);
    Kt = rank_o_p_pe;
    Nt = dim_p_pe;
    vecmat_computation();

    comm_mod.all_reduce_bsz_dim(py, quotient_y, remainder_y, ptr_h1);
}

fn attn_residual_add() void {
    @load_to_dsr(dest_dsr_1, Z_dsd);
    @load_to_dsr(src0_dsr_1, X_dsd);
    @load_to_dsr(src1_dsr_1, h1_dsd);
    @faddh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
}

fn rmsnorm_z() void {
    @load_to_dsr(dest_dsr_1, X_tmp_dsd);
    @load_to_dsr(src0_dsr_1, Z_dsd);
    @load_to_dsr(src1_dsr_1, Z_dsd);
    @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
    
    dim_p_pe_dsd_1 = @set_dsd_base_addr(dim_p_pe_dsd_1, ptr_X_tmp);
    @load_to_dsr(src1_dsr_1, dim_p_pe_dsd_1, .{ .save_address = true });
    for (@range(i16, bsz)) |b| {
        sum = 0.0;
        @faddh(ptr_sum, sum, src1_dsr_1);
        local_sum[b] = sum;
    }

    comm_mod.all_reduce_bsz(py, quotient_y, remainder_y, ptr_local_sum);

    dim_p_pe_dsd_1 = @set_dsd_base_addr(dim_p_pe_dsd_1, ptr_z_norm);
    dim_p_pe_dsd_2 = @set_dsd_base_addr(dim_p_pe_dsd_2, ptr_X_tmp);
    @load_to_dsr(dest_dsr_1, dim_p_pe_dsd_1, .{ .save_address = true });
    @load_to_dsr(src0_dsr_1, dim_p_pe_dsd_2, .{ .save_address = true });
    @load_to_dsr(src1_dsr_1, W_dsd, .{ .save_address = false });
    for (@range(i16, bsz)) |b| {
        @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
    }

    seq_len_p_pe_dsd_1 = @set_dsd_base_addr(seq_len_p_pe_dsd_1, ptr_z_norm);
    @load_to_dsr(dest_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
    @load_to_dsr(src0_dsr_1, seq_len_p_pe_dsd_1, .{ .save_address = true });
    @map(fmulh_norm_func, local_sum_dsd);
}

fn up_matvec_mult() void {
    @fmovh(up_rank_dsd, 0.0);
    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_z_norm);
    ptr_right_matrix = &UP_A_weight_tile;
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_ZZ_rank_tile);
    Kt = dim_p_pe;
    Nt = rank_ffn_p_pe;
    vecmat_computation();
}

fn gate_matvec_mult() void {
    @fmovh(gate_rank_dsd, 0.0);
    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_z_norm);
    ptr_right_matrix = &GATE_A_weight_tile;
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_ZZ_rank_tile);
    out_vector_dsd = @increment_dsd_offset(out_vector_dsd, bsz * rank_ffn_p_pe, f16);
    Kt = dim_p_pe;
    Nt = rank_ffn_p_pe;
    vecmat_computation();
}

fn up_gate_low_rank_stage2() void {
    comm_mod.reconfig_allreduce_axis(1);
    @fmovh(z1_dsd, 0.0);
    @fmovh(z2_dsd, 0.0);

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_ZZ_rank_tile);
    ptr_right_matrix = &UP_B_weight_tile;
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_ZZ_tile);
    Kt = rank_ffn_p_pe; Nt = ffn_dim_p_pe; vecmat_computation();

    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_ZZ_rank_tile);
    left_vector_dsd = @increment_dsd_offset(left_vector_dsd, bsz * rank_ffn_p_pe, f16);
    ptr_right_matrix = &GATE_B_weight_tile;
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_ZZ_tile);
    out_vector_dsd = @increment_dsd_offset(out_vector_dsd, bsz * ffn_dim_p_pe, f16);
    Kt = rank_ffn_p_pe; Nt = ffn_dim_p_pe; vecmat_computation();

    comm_mod.all_reduce_bsz_ffn_dim_ZZ_fusion(py, quotient_y, remainder_y, ptr_ZZ_tile);
}

var z2_val: f16 = 0.0;
fn z2_silu() void {
    // SiLU is applied to the GATE projection (z2), which lives at offset
    // bsz*ffn_dim_p_pe in ZZ_tile and spans bsz*ffn_dim_p_pe elements.
    const z2_base: i16 = bsz * ffn_dim_p_pe;
    for (@range(i16, bsz * ffn_dim_p_pe)) |i| {
        z2_val = ZZ_tile[z2_base + i];
        ZZ_tile[z2_base + i] = z2_val / (1.0 + fast_exp(-z2_val));
    }
}

fn z3_mat() void {
    @load_to_dsr(dest_dsr_1, z3_dsd);
    @load_to_dsr(src0_dsr_1, z1_dsd);
    @load_to_dsr(src1_dsr_1, z2_dsd);
    @fmulh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
}

fn down_low_rank_matvec_mult() void {
    // Stage 1: z3 is sharded over PE columns. Each PE computes one block of
    // z3 @ DOWN_A, then columns cooperate along X to form a rank shard.
    @fmovh(down_rank_dsd, 0.0);
    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_z3);
    ptr_right_matrix = &DOWN_A_weight_tile;
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_down_rank);
    Kt = ffn_dim_p_pe;
    Nt = rank_down_p_pe;
    vecmat_computation();
    comm_mod.all_reduce_bsz_rank_down(px, quotient_x, remainder_x, ptr_down_rank);

    // Stage 2: switch to the orthogonal axis, multiply each rank shard by its
    // DOWN_B block, and reduce those contributions into the hidden shard h2.
    comm_mod.reconfig_allreduce_axis(1);
    @fmovh(h2_dsd, 0.0);
    left_vector_dsd = @set_dsd_base_addr(left_vector_dsd, ptr_down_rank);
    ptr_right_matrix = &DOWN_B_weight_tile;
    out_vector_dsd = @set_dsd_base_addr(out_vector_dsd, ptr_h2);
    Kt = rank_down_p_pe;
    Nt = dim_p_pe;
    vecmat_computation();
    comm_mod.all_reduce_bsz_dim(py, quotient_y, remainder_y, ptr_h2);
}

fn ffn_residual_add() void {
    @load_to_dsr(dest_dsr_1, Z_dsd);
    @load_to_dsr(src0_dsr_1, Z_dsd);
    @load_to_dsr(src1_dsr_1, h2_dsd);
    @faddh(dest_dsr_1, src0_dsr_1, src1_dsr_1);
}

fn decode_struct() void {

    rmsnorm_x();

    xq_matvec_mult();
    xk_matvec_mult();
    xv_matvec_mult();
    comm_mod.all_reduce_bsz_rank_QKV_fusion(py, quotient_y, remainder_y, ptr_QKV_rank_tile);
    qkv_low_rank_stage2();

    xq_rope();
    xk_rope();

    score_matvec_mult();

    comm_mod.reconfig_allreduce_axis(1);

    softmax_score();

    output_matvec_mult();

    comm_mod.reconfig_allreduce_axis(0);

    o_low_rank_matvec_mult();

    attn_residual_add();

    // o_low_rank_matvec_mult() leaves the all-reduce routes on the Y axis,
    // which is exactly what the following RMSNorm needs.

    rmsnorm_z();

    comm_mod.reconfig_allreduce_axis(0);

    up_matvec_mult();
    gate_matvec_mult();
    comm_mod.all_reduce_bsz_rank_FFN_fusion(px, quotient_x, remainder_x, ptr_ZZ_rank_tile);
    up_gate_low_rank_stage2();

    z2_silu();

    z3_mat();

    comm_mod.reconfig_allreduce_axis(0);

    down_low_rank_matvec_mult();

    ffn_residual_add();

    // down_low_rank_matvec_mult() already leaves routes on Y, which is the
    // axis required by the next decoder iteration's RMSNorm.

    decode_entry();
}

// Run one diagnostic decoder iteration with markers around the four
// low-rank projection groups. This intentionally duplicates decode_struct's
// orchestration: adding conditional markers to decode_struct would perturb
// the normal cycle measurement even when profiling was disabled.
fn projection_profile_struct() void {
    rmsnorm_x();

    timestamp.get_timestamp(&tsc_qkv_start);
    xq_matvec_mult();
    xk_matvec_mult();
    xv_matvec_mult();
    comm_mod.all_reduce_bsz_rank_QKV_fusion(py, quotient_y, remainder_y, ptr_QKV_rank_tile);
    qkv_low_rank_stage2();
    timestamp.get_timestamp(&tsc_qkv_end);

    xq_rope();
    xk_rope();
    score_matvec_mult();
    comm_mod.reconfig_allreduce_axis(1);
    softmax_score();
    output_matvec_mult();

    // Include the route selection needed to enter each projection group. It
    // is part of the actual cost paid by that group in decode_struct().
    timestamp.get_timestamp(&tsc_o_start);
    comm_mod.reconfig_allreduce_axis(0);
    o_low_rank_matvec_mult();
    timestamp.get_timestamp(&tsc_o_end);

    attn_residual_add();
    rmsnorm_z();

    timestamp.get_timestamp(&tsc_up_gate_start);
    comm_mod.reconfig_allreduce_axis(0);
    up_matvec_mult();
    gate_matvec_mult();
    comm_mod.all_reduce_bsz_rank_FFN_fusion(px, quotient_x, remainder_x, ptr_ZZ_rank_tile);
    up_gate_low_rank_stage2();
    timestamp.get_timestamp(&tsc_up_gate_end);

    z2_silu();
    z3_mat();

    timestamp.get_timestamp(&tsc_down_start);
    comm_mod.reconfig_allreduce_axis(0);
    down_low_rank_matvec_mult();
    timestamp.get_timestamp(&tsc_down_end);

    ffn_residual_add();
    projection_profile_exit();
}

fn exit() void {
    timestamp.get_timestamp(&tsc_end_buf);
    timestamp.disable_tsc();

    f_reference_timestamps();
    f_memcpy_timestamps();
    sys_mod.unblock_cmd_stream();
}


// -------------------------------------------------------------------------- //
// ------------------------------ Entry Point ----------------------------- //
// -------------------------------------------------------------------------- //
var total_repeat_times: i16 = 1;
var total_warmup_times: i16 = 0;
var repeat_times: i16 = 0; // Start from 0

fn decode_host(total_warmup_times_: i16, total_repeat_times_: i16) void {
    total_warmup_times = total_warmup_times_;
    total_repeat_times = total_repeat_times_;
    repeat_times = 0;

    decode_entry();
}

// Separate diagnostic entry point. decode_host() disables the TSC when it
// finishes, so re-enable it for this additional, non-benchmark iteration.
fn projection_profile_host() void {
    timestamp.enable_tsc();
    projection_profile_struct();
}

fn decode_entry() void {
    // Run (total_warmup_times + total_repeat_times) times; only the last `total_repeat_times` iterations are timed
    if (repeat_times == total_warmup_times + total_repeat_times) {
        exit();
    } else {
        if (repeat_times == total_warmup_times) {
            timestamp.get_timestamp(&tsc_ref_buf);
            timestamp.get_timestamp(&tsc_start_buf);
        }

        repeat_times += 1;
        decode_struct();
    }
}


// -------------------------------------------------------------------------- //
// ------------------------------- Timer Funcs ------------------------------ //
// -------------------------------------------------------------------------- //

fn f_memcpy_timestamps() void {
    var lo_ : u16 = 0;
    var hi_ : u16 = 0;
    var word : u32 = 0;

    lo_ = tsc_start_buf[0];
    hi_ = tsc_start_buf[1];
    timer_buf[0] = @bitcast(f32, (@as(u32,hi_) << @as(u16,16)) | @as(u32, lo_) );

    lo_ = tsc_start_buf[2];
    hi_ = tsc_end_buf[0];
    timer_buf[1] = @bitcast(f32, (@as(u32,hi_) << @as(u16,16)) | @as(u32, lo_) );

    lo_ = tsc_end_buf[1];
    hi_ = tsc_end_buf[2];
    timer_buf[2] = @bitcast(f32, (@as(u32,hi_) << @as(u16,16)) | @as(u32, lo_) );
}

fn pack_profile_interval(start: [*]u16, end: [*]u16, offset: i16) void {
    var lo_: u16 = start[0];
    var hi_: u16 = start[1];
    projection_profile_buf[offset] = @bitcast(
        f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_)
    );

    lo_ = start[2];
    hi_ = end[0];
    projection_profile_buf[offset + 1] = @bitcast(
        f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_)
    );

    lo_ = end[1];
    hi_ = end[2];
    projection_profile_buf[offset + 2] = @bitcast(
        f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_)
    );
}

fn projection_profile_exit() void {
    timestamp.disable_tsc();
    pack_profile_interval(&tsc_qkv_start, &tsc_qkv_end, 0);
    pack_profile_interval(&tsc_o_start, &tsc_o_end, 3);
    pack_profile_interval(&tsc_up_gate_start, &tsc_up_gate_end, 6);
    pack_profile_interval(&tsc_down_start, &tsc_down_end, 9);
    sys_mod.unblock_cmd_stream();
}

fn f_reference_timestamps() void {
    var lo_ : u16 = 0;
    var hi_ : u16 = 0;

    lo_ = tsc_ref_buf[0];
    hi_ = tsc_ref_buf[1];
    time_ref_f32[0] = @bitcast(f32, (@as(u32,hi_) << @as(u16,16)) | @as(u32, lo_) );

    lo_ = tsc_ref_buf[2];
    hi_ = 0;
    time_ref_f32[1] = @bitcast(f32, (@as(u32,hi_) << @as(u16,16)) | @as(u32, lo_) );
}

